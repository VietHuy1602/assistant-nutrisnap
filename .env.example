# ==============================================================================
# NutriSnap - Virtual AI Nutrition Assistant
# Environment Variables Configuration Template
# ==============================================================================
# Hướng dẫn khởi tạo môi trường:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# Tuyệt đối không commit tệp .env chứa API Key hoặc Secret thực tế lên Git!
# ==============================================================================

# 1. Google Gemini API Key (cho AI Vision & Tool Calling)
# Lấy API Key cá nhân miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Khóa bí mật mã hóa JWT Token (bắt buộc tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự)
# Lệnh sinh khóa ngẫu nhiên trên Terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_GENERATE_VIA_SECRETS_TOKEN_HEX

# 3. Chuỗi kết nối Cơ sở dữ liệu SQLite cục bộ
DATABASE_URL=sqlite:///./nutrisnap.db

# 4. Cấu hình môi trường ứng dụng (development / production)
APP_ENV=development
DEBUG=True

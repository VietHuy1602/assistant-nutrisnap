# ==============================================================================
# NutriSnap - Virtual AI Nutrition Assistant
# Environment Variables Configuration Template
# ==============================================================================
# Hướng dẫn khởi tạo môi trường:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# Tuyệt đối không commit tệp .env chứa API Key hoặc Secret thực tế lên Git!
# ==============================================================================

# 1. Google Gemini API Key (cho AI Vision & Tool Calling)
# Lấy API Key cá nhân miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Cấu hình bảo mật JWT & Hashing (Mục 4 - Phase 2)
# Sinh khóa ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=nutriscan-api
BCRYPT_ROUNDS=12

# 3. Chuỗi kết nối Cơ sở dữ liệu SQLite cục bộ
DATABASE_URL=sqlite:///./nutrisnap.db

# 4. Cấu hình môi trường ứng dụng (development / production)
APP_ENV=development
DEBUG=True


# ==============================================================================
# NutriSnap - Virtual AI Nutrition Assistant
# Environment Variables Configuration Template
# ==============================================================================
# Hướng dẫn khởi tạo môi trường:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# Tuyệt đối không commit tệp .env chứa API Key hoặc Secret thực tế lên Git!
# ==============================================================================

# 1. Google Gemini API Key (cho AI Vision & Tool Calling)
# Lấy API Key cá nhân miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Cấu hình bảo mật JWT & Hashing (Mục 4 - Phase 2)
# Sinh khóa ngẫu nhiên: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=nutrisnap-api
BCRYPT_ROUNDS=12
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax

# 3. Chuỗi kết nối Cơ sở dữ liệu SQLite cục bộ
DATABASE_URL=sqlite:///./nutrisnap.db

# 4. Cấu hình môi trường ứng dụng (development / production)
APP_ENV=development
DEBUG=True

# 5. Cấu hình AI Orchestrator & LLM Client (Phase 4 & 5)
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOOL_ROUNDS=5
USE_LLM=true



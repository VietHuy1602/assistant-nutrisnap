# ==============================================================================
# NutriSnap - Virtual AI Nutrition Assistant
# Environment Variables Configuration Template
# ==============================================================================
# Hướng dẫn: Sao chép tệp này sang .env trước khi khởi chạy ứng dụng:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# Tuyệt đối không commit tệp .env chứa API Key thực tế lên Git!
# ==============================================================================

# 1. Google Gemini API Key (cho AI Vision & Orchestrator Tool Calling)
GEMINI_API_KEY=your_actual_api_key_here

# 2. Khóa bí mật mã hóa JWT Token (chuỗi ngẫu nhiên tối thiểu 32 ký tự)
JWT_SECRET_KEY=nutrisnap_secure_secret_jwt_key_at_least_32_characters_long_2026

# 3. Chuỗi kết nối Cơ sở dữ liệu SQLite
DATABASE_URL=sqlite:///./nutrisnap.db

# 4. Cấu hình môi trường ứng dụng (development / production)
APP_ENV=development
DEBUG=True
